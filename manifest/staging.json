    "k1_restore": [
      {
        "type": "info",
        "text": "This removes HelixScreen and puts back the screen the printer had before it: GrumpyScreen on Simple AF. Creality's own screen and software come back only with a factory reset or Creality's recovery firmware; the K1 guide explains both: https://helixscreen.org/docs/install-k1"
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2023"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": "k1",
        "uninstall": true,
        "dir": "/usr/data",
        "commits": true
      }
    ],
    "ad5x_zmod": [
      {
        "type": "info",
        "text": "Find the printer's firmware version: on its screen open Settings, then the About page. The installer asks for it next.",
        "image": "ad5x/about-screen.png"
      },
      {
        "type": "ask",
        "fact": "stock_version",
        "question": "Which firmware version does the About page show?",
        "choices": [
          {
            "value": "1.1.7",
            "label": "1.1.7"
          },
          {
            "value": "1.1.9",
            "label": "1.1.9"
          },
          {
            "value": "1.2.0",
            "label": "1.2.0"
          },
          {
            "value": "1.2.1",
            "label": "1.2.1"
          },
          {
            "value": "1.2.2",
            "label": "1.2.2"
          },
          {
            "value": "1.2.3",
            "label": "1.2.3"
          },
          {
            "value": "3.0.3",
            "label": "3.0.3"
          },
          {
            "value": "3.0.9",
            "label": "3.0.9"
          },
          {
            "value": "3.1.0",
            "label": "3.1.0"
          },
          {
            "value": "0",
            "label": "Another version"
          }
        ]
      },
      {
        "type": "require",
        "fact": "stock_version",
        "range": "=1.1.7 || =1.1.9 || =1.2.0 || =1.2.1 || =1.2.2 || =1.2.3 || =3.0.3 || =3.0.9 || =3.1.0",
        "reason": "ZMOD installs only over stock firmware 1.1.7 to 1.2.3 (not 1.1.8), 3.0.3, 3.0.9 or 3.1.0. The AD5X guide explains how to put a supported version on first.",
        "doc": "https://helixscreen.org/docs/install-ad5x"
      },
      {
        "type": "info",
        "text": "ZMOD's own guide asks for the printer to be reset to factory settings before the mod goes on. If you have changed settings or installed anything since the firmware was last flashed, reset it from the printer's Settings first. Then press Next to copy ZMOD onto a USB stick."
      },
      {
        "type": "download",
        "artifact": "zmod_1.7.4_ad5x"
      },
      {
        "type": "write_stick",
        "artifacts": [
          "zmod_1.7.4_ad5x"
        ]
      },
      {
        "type": "user_action",
        "text": "Turn the printer off, put the USB stick in the printer's USB port, then turn the printer on. It installs ZMOD by itself, which can take up to 40 minutes. Press Next once the printer is on.",
        "image": "ad5x/usb-port.png",
        "commits": true
      },
      {
        "type": "wait_for",
        "target": "moonraker",
        "timeout_s": 2400,
        "message": "ZMOD is installing; this can take up to 40 minutes. Do not power off the printer. Remove the USB stick afterwards.",
        "help": "If the printer's screen shows an error or stays on one message for a long time, follow the AD5X guide: https://helixscreen.org/docs/install-ad5x"
      },
      {
        "type": "user_action",
        "text": "Remove the USB stick from the printer now. Left in, it installs ZMOD again on the next start."
      },
