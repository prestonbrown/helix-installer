{
  "manifest_version": 1,
  "min_app_version": "0.1.0",
  "printers": [
    {
      "id": "generic_klipper",
      "name": "Klipper host (Voron, MainsailOS, FluiddPi, KIAUH)",
      "identify": [
        {
          "os_distribution": {
            "prefix": "Debian GNU/Linux"
          },
          "klipper_hostname": {
            "not": "linaro-alip"
          }
        },
        {
          "os_distribution": {
            "prefix": "Raspbian GNU/Linux"
          }
        },
        {
          "os_distribution": {
            "prefix": "Armbian"
          }
        },
        {
          "os_distribution": {
            "prefix": "Ubuntu"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix",
            "cpu_arch": "aarch64"
          },
          "recipe": "generic_update"
        },
        {
          "when": {
            "state": "helix",
            "cpu_arch": "armv7l"
          },
          "recipe": "generic_update"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "cpu_arch": "aarch64"
          },
          "recipe": "generic_install"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "cpu_arch": "armv7l"
          },
          "recipe": "generic_install"
        }
      ],
      "restore": "generic_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-generic"
      }
    },
    {
      "id": "qidi",
      "name": "QIDI Q2 / Max 4 / Plus 5",
      "identify": [
        {
          "klipper_hostname": "linaro-alip",
          "cpu_arch": "aarch64"
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix"
          },
          "recipe": "qidi_update"
        },
        {
          "when": {
            "state": "modded:moonraker"
          },
          "recipe": "qidi_install"
        }
      ],
      "restore": "qidi_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-qidi"
      }
    },
    {
      "id": "k2",
      "name": "Creality K2 / K2 Plus / K2 Pro",
      "identify": [
        {
          "cpu_arch": "armv7l",
          "klipper_objects": {
            "contains": "motor_control"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix"
          },
          "recipe": "k2_update"
        },
        {
          "when": {
            "state": "modded:moonraker"
          },
          "recipe": "k2_install"
        }
      ],
      "restore": "k2_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-k2"
      }
    },
    {
      "id": "k1",
      "name": "Creality K1 / K1C / K1 Max",
      "identify": [
        {
          "cpu_arch": "mips",
          "klipper_objects": {
            "contains": "mcu nozzle_mcu"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix"
          },
          "recipe": "k1_update"
        },
        {
          "when": {
            "state": "modded:moonraker"
          },
          "recipe": "k1_modded"
        },
        {
          "when": {
            "state": "stock"
          },
          "recipe": "k1_stock"
        }
      ],
      "restore": "k1_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-k1"
      }
    }
  ],
  "artifacts": {},
  "recipes": {
    "generic_install": [
      {
        "type": "ssh_login",
        "logins": [],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": {
          "from_arch": {
            "aarch64": "pi",
            "armv7l": "pi32"
          }
        },
        "commits": true
      }
    ],
    "generic_update": [
      {
        "type": "ssh_login",
        "logins": [],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": {
          "from_arch": {
            "aarch64": "pi",
            "armv7l": "pi32"
          }
        },
        "update": true,
        "commits": true
      }
    ],
    "generic_restore": [
      {
        "type": "ssh_login",
        "logins": [],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": {
          "from_arch": {
            "aarch64": "pi",
            "armv7l": "pi32"
          }
        },
        "uninstall": true,
        "commits": true
      }
    ],
    "qidi_install": [
      {
        "type": "info",
        "text": "HelixScreen replaces QIDI's own screen program. While HelixScreen runs, QIDI Studio cannot see the QIDI Box or send prints to this printer, QIDI cloud is unavailable, and filament changes made for the Box do not stick. Prints can still be sent through Moonraker (Fluidd, Mainsail or a slicer's Klipper connection). Removing HelixScreen later brings all of this back."
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "qidi",
            "password": "qiditech"
          },
          {
            "user": "mks",
            "password": "makerbase"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": "pi",
        "commits": true
      }
    ],
    "qidi_update": [
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "qidi",
            "password": "qiditech"
          },
          {
            "user": "mks",
            "password": "makerbase"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": "pi",
        "update": true,
        "commits": true
      }
    ],
    "qidi_restore": [
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "qidi",
            "password": "qiditech"
          },
          {
            "user": "mks",
            "password": "makerbase"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": "pi",
        "uninstall": true,
        "commits": true
      }
    ],
    "k2_install": [
      {
        "type": "user_action",
        "text": "Turn on root access on the printer: on its screen open Settings, then Root account information. Read the notice, wait the 30 seconds it asks for, then press OK. Leave that screen open: it shows the root password, which the installer may ask for. Then press Next here.",
        "image": "k2/root-account.png",
        "verify": {
          "tcp_port": 22,
          "fact": "ssh_open"
        }
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2024"
          }
        ],
        "ask_if_failed": true,
        "password_hint": "the password shown on the printer's root screen"
      },
      {
        "type": "probe",
        "ssh": "test -e /etc/init.d/S99helixscreen && echo yes || echo no",
        "fact": "helix_installed"
      },
      {
        "type": "helix_install",
        "platform": "k2",
        "dir": "/mnt/UDISK",
        "commits": true
      }
    ],
    "k2_update": [
      {
        "type": "user_action",
        "text": "Turn on root access on the printer: on its screen open Settings, then Root account information. Read the notice, wait the 30 seconds it asks for, then press OK. Leave that screen open: it shows the root password, which the installer may ask for. Then press Next here.",
        "image": "k2/root-account.png",
        "verify": {
          "tcp_port": 22,
          "fact": "ssh_open"
        }
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2024"
          }
        ],
        "ask_if_failed": true,
        "password_hint": "the password shown on the printer's root screen"
      },
      {
        "type": "probe",
        "ssh": "test -e /etc/init.d/S99helixscreen && echo yes || echo no",
        "fact": "helix_installed"
      },
      {
        "type": "helix_install",
        "platform": "k2",
        "update": true,
        "dir": "/mnt/UDISK",
        "commits": true
      }
    ],
    "k2_restore": [
      {
        "type": "user_action",
        "text": "Turn on root access on the printer: on its screen open Settings, then Root account information. Read the notice, wait the 30 seconds it asks for, then press OK. Leave that screen open: it shows the root password, which the installer may ask for. Then press Next here.",
        "image": "k2/root-account.png",
        "verify": {
          "tcp_port": 22,
          "fact": "ssh_open"
        }
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2024"
          }
        ],
        "ask_if_failed": true,
        "password_hint": "the password shown on the printer's root screen"
      },
      {
        "type": "helix_install",
        "platform": "k2",
        "uninstall": true,
        "dir": "/mnt/UDISK",
        "commits": true
      }
    ],
    "k1_stock": [
      {
        "type": "ask",
        "fact": "k1_root_menu",
        "question": "On the printer's screen, open Settings. Is there an entry called Root account information?",
        "choices": [
          {
            "value": "yes",
            "label": "Yes, it is there",
            "image": "k1/root-account.png"
          },
          {
            "value": "no",
            "label": "No, it is missing"
          }
        ]
      },
      {
        "type": "require",
        "fact": "k1_root_menu",
        "equals": "yes",
        "reason": "This printer has no root option. Some 2025 K1C units ship without it, and the installer cannot put HelixScreen on them.",
        "doc": "https://helixscreen.org/docs/install-k1"
      },
      {
        "type": "info",
        "text": "Before you start: the installer first puts Simple AF, a community firmware, on this printer, then HelixScreen. Going back to Creality's own software later takes a factory reset or Creality's recovery firmware; removing only HelixScreen is quick and leaves Simple AF's screen."
      },
      {
        "type": "user_action",
        "text": "Turn on root access: on the printer's screen open Settings, then Root account information. Read the notice, wait for the countdown, then press OK. Then press Next here.",
        "image": "k1/root-account.png",
        "verify": {
          "tcp_port": 22,
          "fact": "ssh_open"
        }
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2023"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "probe",
        "ssh": "uname -m",
        "fact": "cpu_arch"
      },
      {
        "type": "probe",
        "ssh": "test -e /etc/init.d/S99helixscreen && echo yes || echo no",
        "fact": "helix_installed"
      },
      {
        "type": "probe",
        "ssh": "sed -n 's/^ota_version=6\\.//p' /etc/ota_info",
        "fact": "k1_firmware_version"
      },
      {
        "type": "require",
        "fact": "k1_firmware_version",
        "range": ">=1.3.3.5",
        "reason": "Simple AF needs Creality firmware 1.3.3.5 or newer. Update the printer from its own screen, then run the installer again.",
        "doc": "https://helixscreen.org/docs/install-k1"
      },
      {
        "type": "probe",
        "ssh": "if [ -d /usr/data/helper-script ] || [ -f /usr/data/fluidd.sh ] || [ -f /usr/data/mainsail.sh ] || { [ -d /opt ] && [ ! -L /opt ] && [ -n \"$(ls -1 /opt)\" ]; }; then echo yes; else echo no; fi",
        "fact": "k1_leftovers"
      },
      {
        "type": "require",
        "fact": "k1_leftovers",
        "equals": "false",
        "reason": "Something from an earlier mod is on this printer (Helper Script, Creality's Fluidd or Mainsail script, or files in /opt). Simple AF installs only on a printer fresh from a factory reset: reset it from its Settings, then run the installer again.",
        "doc": "https://helixscreen.org/docs/install-k1"
      },
      {
        "type": "ssh_run",
        "command": "git config --global http.sslVerify false; git clone https://github.com/pellcorp/creality.git /usr/data/pellcorp && sh /usr/data/pellcorp/k1/installer.sh --install loadcells",
        "timeout_s": 1800,
        "commits": true
      },
      {
        "type": "wait_for",
        "target": "moonraker",
        "timeout_s": 900,
        "message": "Simple AF is starting the printer's new services. Do not power off the printer.",
        "help": "If the printer's screen shows an error, follow the recovery steps in the K1 guide: https://helixscreen.org/docs/install-k1"
      },
      {
        "type": "probe",
        "moonraker": "objects_list"
      },
      {
        "type": "helix_install",
        "platform": "k1",
        "dir": "/usr/data"
      }
    ],
    "k1_modded": [
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2023"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "probe",
        "ssh": "test -e /etc/init.d/S99helixscreen && echo yes || echo no",
        "fact": "helix_installed"
      },
      {
        "type": "helix_install",
        "platform": "k1",
        "dir": "/usr/data",
        "commits": true
      }
    ],
    "k1_update": [
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2023"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "probe",
        "ssh": "test -e /etc/init.d/S99helixscreen && echo yes || echo no",
        "fact": "helix_installed"
      },
      {
        "type": "helix_install",
        "platform": "k1",
        "update": true,
        "dir": "/usr/data",
        "commits": true
      }
    ],
    "k1_restore": [
      {
        "type": "info",
        "text": "This removes HelixScreen and puts back the screen the printer had before it: GrumpyScreen on Simple AF. Creality's own screen and software come back only with a factory reset or Creality's recovery firmware; the K1 guide explains both: https://helixscreen.org/docs/install-k1"
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "root",
            "password": "creality_2023"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": "k1",
        "uninstall": true,
        "dir": "/usr/data",
        "commits": true
      }
    ]
  }
}
