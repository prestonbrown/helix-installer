    "qidi_install": [
      {
        "type": "info",
        "text": "HelixScreen replaces QIDI's own screen program. While HelixScreen runs, QIDI Studio cannot see the QIDI Box or send prints to this printer, QIDI cloud is unavailable, and filament changes made for the Box do not stick. Prints can still be sent through Moonraker (Fluidd, Mainsail or a slicer's Klipper connection). Removing HelixScreen later brings all of this back."
      },
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "qidi",
            "password": "qiditech"
          },
          {
            "user": "mks",
            "password": "makerbase"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": "pi",
        "commits": true
      }
    ],
    "qidi_update": [
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "qidi",
            "password": "qiditech"
          },
          {
            "user": "mks",
            "password": "makerbase"
          }
        ],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": "pi",
        "update": true,
        "commits": true
      }
    ],
    "qidi_restore": [
      {
        "type": "ssh_login",
        "logins": [
          {
            "user": "qidi",
            "password": "qiditech"
          },
