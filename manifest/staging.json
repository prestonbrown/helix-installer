{
  "manifest_version": 1,
  "min_app_version": "0.1.0",
  "printers": [
    {
      "id": "generic_klipper",
      "name": "Klipper host (Voron, MainsailOS, FluiddPi, KIAUH)",
      "identify": [
        {
          "os_distribution": {
            "prefix": "Debian GNU/Linux"
          },
          "klipper_hostname": {
            "not": "linaro-alip"
          }
        },
        {
          "os_distribution": {
            "prefix": "Raspbian GNU/Linux"
          }
        },
        {
          "os_distribution": {
            "prefix": "Armbian"
          }
        },
        {
          "os_distribution": {
            "prefix": "Ubuntu"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix",
            "cpu_arch": "aarch64"
          },
          "recipe": "generic_update"
        },
        {
          "when": {
            "state": "helix",
            "cpu_arch": "armv7l"
          },
          "recipe": "generic_update"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "cpu_arch": "aarch64"
          },
          "recipe": "generic_install"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "cpu_arch": "armv7l"
          },
          "recipe": "generic_install"
        }
      ],
      "restore": "generic_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-generic"
      }
    },
    {
      "id": "qidi",
      "name": "QIDI Q2 / Max 4 / Plus 5",
      "identify": [
        {
          "klipper_hostname": "linaro-alip",
          "cpu_arch": "aarch64"
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix"
          },
          "recipe": "qidi_update"
        },
        {
          "when": {
            "state": "modded:moonraker"
          },
          "recipe": "qidi_install"
        }
      ],
      "restore": "qidi_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-qidi"
      }
    },
    {
      "id": "k2",
      "name": "Creality K2 / K2 Plus / K2 Pro",
      "identify": [
        {
          "cpu_arch": "armv7l",
          "klipper_objects": {
            "contains": "motor_control"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix"
          },
          "recipe": "k2_update"
        },
        {
          "when": {
            "state": "modded:moonraker"
          },
          "recipe": "k2_install"
        }
      ],
      "restore": "k2_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-k2"
      }
    },
    {
      "id": "k1",
      "name": "Creality K1 / K1C / K1 Max",
      "identify": [
        {
          "cpu_arch": "mips",
          "klipper_objects": {
            "contains": "mcu nozzle_mcu"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix"
          },
          "recipe": "k1_update"
        },
        {
          "when": {
            "state": "modded:moonraker"
          },
          "recipe": "k1_modded"
        },
        {
          "when": {
            "state": "stock"
          },
          "recipe": "k1_stock"
        }
      ],
      "restore": "k1_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-k1"
      }
    },
    {
      "id": "ad5x",
      "name": "FlashForge Adventurer 5X",
      "identify": [
        {
          "flashforge_udp.model": "AD5X"
        },
        {
          "klipper_objects": {
            "contains": "zmod_ifs"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix"
          },
          "recipe": "ad5x_helix_update"
        },
        {
          "when": {
            "state": "modded:moonraker"
          },
          "recipe": "ad5x_enable_helix"
        },
        {
          "when": {
            "state": "stock"
          },
          "recipe": "ad5x_zmod"
        }
      ],
      "restore": "ad5x_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-ad5x"
      }
    },
    {
      "id": "ad5m",
      "name": "FlashForge Adventurer 5M",
      "identify": [
        {
          "flashforge_udp.model": "Adventurer5M"
        },
        {
          "klipper_objects": {
            "contains": "gcode_macro SUPPORT_FORGE_X"
          }
        },
        {
          "os_distribution": {
            "prefix": "Forge-X"
          }
        },
        {
          "cpu_arch": "armv7l",
          "klipper_objects": {
            "contains": "zmod"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix",
            "os_distribution": {
              "prefix": "Forge-X"
            }
          },
          "recipe": "ad5m_forgex_update"
        },
        {
          "when": {
            "state": "helix",
            "klipper_objects": {
              "contains": "zmod"
            }
          },
          "recipe": "ad5m_zmod_update"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "os_distribution": {
              "prefix": "Forge-X"
            }
          },
          "recipe": "ad5m_forgex_install"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "klipper_objects": {
              "contains": "zmod"
            }
          },
          "recipe": "ad5m_zmod_enable"
        },
        {
          "when": {
            "state": "stock"
          },
          "recipe": "ad5m_forgex"
        }
      ],
      "restore": "ad5m_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-ad5m"
      }
    },
    {
      "id": "ad5m_pro",
      "name": "FlashForge Adventurer 5M Pro",
      "identify": [
        {
          "flashforge_udp.model": "Adventurer5MPro"
        },
        {
          "klipper_objects": {
            "contains": "gcode_macro SUPPORT_FORGE_X"
          }
        },
        {
          "os_distribution": {
            "prefix": "Forge-X"
          }
        },
        {
          "cpu_arch": "armv7l",
          "klipper_objects": {
            "contains": "zmod"
          }
        }
      ],
      "recipes": [
        {
          "when": {
            "state": "helix",
            "os_distribution": {
              "prefix": "Forge-X"
            }
          },
          "recipe": "ad5m_forgex_update"
        },
        {
          "when": {
            "state": "helix",
            "klipper_objects": {
              "contains": "zmod"
            }
          },
          "recipe": "ad5m_zmod_update"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "os_distribution": {
              "prefix": "Forge-X"
            }
          },
          "recipe": "ad5m_forgex_install"
        },
        {
          "when": {
            "state": "modded:moonraker",
            "klipper_objects": {
              "contains": "zmod"
            }
          },
          "recipe": "ad5m_zmod_enable"
        },
        {
          "when": {
            "state": "stock"
          },
          "recipe": "ad5m_pro_forgex"
        }
      ],
      "restore": "ad5m_restore",
      "fallback": {
        "refuse": true,
        "doc": "https://helixscreen.org/docs/install-ad5m"
      }
    }
  ],
  "artifacts": {
    "zmod_1.7.4_ad5x": {
      "url": "https://github.com/ghzserg/zmod/releases/download/1.7.4/AD5X-zmod-1.7.4.tgz",
