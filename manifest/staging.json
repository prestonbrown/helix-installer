    ],
    "generic_update": [
      {
        "type": "ssh_login",
        "logins": [],
        "ask_if_failed": true
      },
      {
        "type": "helix_install",
        "platform": {
          "from_arch": {
            "aarch64": "pi",
            "armv7l": "pi32"
          }
        },
        "update": true,
